{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "Español",
  "editorMode": "vim",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "enableWorkflows": true,
  "extraKnownMarketplaces": {
    "better-claude": {
      "source": {
        "source": "github",
        "repo": "midudev/better-claude"
      }
    }
  },
  "enabledPlugins": {
    "cc-plugin-telemetry@builtin": false,
    "commit@better-claude": true,
    "sub-meter@better-claude": true,
    "token-meter@better-claude": true,
    "context-meter@better-claude": true,
    "after@better-claude": true,
    "use-haiku@better-claude": true,
    "think-hard@better-claude": true,
    "image-preview@better-claude": false,
    "narrator@better-claude": false
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(tgrep *)",
      "Bash(ast-grep *)",
      "Bash(jq *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git blame*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh issue view*)",
      "Bash(php -l *)",
      "Bash(composer validate*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  }
}
